{
  "name": "Not Function Tests",
  "description": "Tests for the not() function including spec-based tests",
  "tests": [
    {
      "name": "not() - true",
      "expression": "true.not()",
      "input": [],
      "expected": [
        false
      ],
      "tags": [
        "function",
        "logical",
        "not",
        "function:not"
      ]
    },
    {
      "name": "not() - false",
      "expression": "false.not()",
      "input": [],
      "expected": [
        true
      ],
      "tags": [
        "function",
        "logical",
        "not",
        "function:not"
      ]
    },
    {
      "name": "not() - empty collection",
      "expression": "({}).not()",
      "input": [],
      "expected": [],
      "tags": [
        "function",
        "logical",
        "not",
        "empty",
        "function:not"
      ]
    },
    {
      "name": "not() - with comparison",
      "expression": "(1 = 2).not()",
      "input": [],
      "expected": [
        true
      ],
      "tags": [
        "function",
        "logical",
        "not",
        "comparison",
        "function:not"
      ]
    },
    {
      "name": "not() - on property",
      "expression": "active.not()",
      "input": {"active": false},
      "expected": [
        true
      ],
      "tags": [
        "function",
        "logical",
        "not",
        "navigation",
        "function:not"
      ]
    },
    {
      "name": "not() - chained with exists",
      "expression": "name.exists().not()",
      "input": {"active": true},
      "expected": [
        true
      ],
      "tags": [
        "function",
        "logical",
        "not",
        "exists",
        "function:not"
      ]
    },
    {
      "name": "not() on integer 0",
      "expression": "(0).not()",
      "input": [],
      "expected": [false],
      "tags": ["function", "logical", "not", "number", "xml-behavior", "function:not"],
      "note": "Per XML tests: non-empty collections are truthy, so not() returns false"
    },
    {
      "name": "not() on integer 1",
      "expression": "(1).not()",
      "input": [],
      "expected": [false],
      "tags": ["function", "logical", "not", "number", "xml-behavior", "function:not"],
      "note": "Per XML tests: non-empty collections are truthy, so not() returns false"
    },
    {
      "name": "not() on multiple values",
      "expression": "(1|2).not()",
      "input": [],
      "error": {
        "message": "can only be applied to a single item"
      },
      "tags": ["function", "logical", "not", "multiple", "error", "function:not"],
      "note": "Per XML tests: not() on multiple values should throw an error"
    },
    {
      "name": "not() on string",
      "expression": "'hello'.not()",
      "input": [],
      "expected": [false],
      "tags": ["function", "logical", "not", "string", "xml-behavior", "function:not"],
      "note": "Per XML tests: non-empty collections are truthy, so not() returns false"
    },
    {
      "name": "not() on decimal",
      "expression": "3.14.not()",
      "input": [],
      "expected": [false],
      "tags": ["function", "logical", "not", "decimal", "xml-behavior", "function:not"],
      "note": "Per XML tests: non-empty collections are truthy, so not() returns false"
    }
  ]
}