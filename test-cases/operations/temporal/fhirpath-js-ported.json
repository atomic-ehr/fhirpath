{
  "name": "FHIRPath.js DateTime Tests - Ported",
  "description": "DateTime tests ported from the fhirpath.js test suite",
  "tests": [
    {
      "name": "Parse year literal @2019",
      "expression": "@2019",
      "expected": ["2019"],
      "tags": ["temporal", "literal", "year"]
    },
    {
      "name": "UTC and timezone offset DateTime equality - equal",
      "expression": "@2019-02-03T01:00Z = @2019-02-02T21:00-04:00",
      "expected": [true],
      "tags": ["temporal", "datetime", "timezone", "equality"]
    },
    {
      "name": "UTC and timezone offset DateTime equality - not equal",
      "expression": "@2019-02-03T02:00Z = @2019-02-02T21:00-04:00",
      "expected": [false],
      "tags": ["temporal", "datetime", "timezone", "equality"]
    },
    {
      "name": "String to DateTime conversion",
      "expression": "'2019-02-06T19:17-05:00'.toDateTime() = @2019-02-06T19:17-05:00",
      "expected": [true],
      "tags": ["temporal", "conversion", "toDateTime"]
    },
    {
      "name": "String to Time conversion",
      "expression": "'19:15'.toTime() = @T19:15",
      "expected": [true],
      "tags": ["temporal", "conversion", "toTime"]
    },
    {
      "name": "String to Date conversion",
      "expression": "'2019-02-06'.toDate() = @2019-02-06",
      "expected": [true],
      "tags": ["temporal", "conversion", "toDate"]
    },
    {
      "name": "Empty to DateTime conversion",
      "expression": "({}).empty().toDateTime()",
      "expected": [],
      "tags": ["temporal", "conversion", "empty"]
    },
    {
      "name": "Empty to Time conversion",
      "expression": "({}).empty().toTime()",
      "expected": [],
      "tags": ["temporal", "conversion", "empty"]
    },
    {
      "name": "Empty to Date conversion",
      "expression": "({}).empty().toDate()",
      "expected": [],
      "tags": ["temporal", "conversion", "empty"]
    },
    {
      "name": "DateTime equality - same year",
      "expression": "@2018 = @2018",
      "expected": [true],
      "tags": ["temporal", "equality", "year"]
    },
    {
      "name": "DateTime equality - different year",
      "expression": "@2018 = @2017",
      "expected": [false],
      "tags": ["temporal", "equality", "year"]
    },
    {
      "name": "DateTime equality - same month",
      "expression": "@2018-02 = @2018-02",
      "expected": [true],
      "tags": ["temporal", "equality", "month"]
    },
    {
      "name": "DateTime equality - different month",
      "expression": "@2018-02 = @2018-03",
      "expected": [false],
      "tags": ["temporal", "equality", "month"]
    },
    {
      "name": "DateTime equality - same day",
      "expression": "@2018-02-02 = @2018-02-02",
      "expected": [true],
      "tags": ["temporal", "equality", "day"]
    },
    {
      "name": "DateTime equality - different day",
      "expression": "@2018-02-02 = @2018-02-03",
      "expected": [false],
      "tags": ["temporal", "equality", "day"]
    },
    {
      "name": "DateTime equality - different precision returns empty",
      "expression": "@2018 = @2018-02",
      "expected": [],
      "tags": ["temporal", "equality", "precision"]
    },
    {
      "name": "DateTime equality - different precision with different values",
      "expression": "@2018 = @2019-02",
      "expected": [false],
      "tags": ["temporal", "equality", "precision"]
    },
    {
      "name": "DateTime equality with time - same",
      "expression": "@2018-02-02T12:00 = @2018-02-02T12:00",
      "expected": [true],
      "tags": ["temporal", "equality", "datetime"]
    },
    {
      "name": "DateTime equality with time - different",
      "expression": "@2018-02-02T12:00 = @2018-02-02T13:00",
      "expected": [false],
      "tags": ["temporal", "equality", "datetime"]
    },
    {
      "name": "DateTime equality with seconds - same",
      "expression": "@2018-02-02T12:00:00 = @2018-02-02T12:00:00",
      "expected": [true],
      "tags": ["temporal", "equality", "seconds"]
    },
    {
      "name": "DateTime equality with seconds - different",
      "expression": "@2018-02-02T12:00:00 = @2018-02-02T12:00:01",
      "expected": [false],
      "tags": ["temporal", "equality", "seconds"]
    },
    {
      "name": "DateTime equality with milliseconds - same",
      "expression": "@2018-02-02T12:00:00.000 = @2018-02-02T12:00:00.000",
      "expected": [true],
      "tags": ["temporal", "equality", "milliseconds"]
    },
    {
      "name": "DateTime equality with milliseconds - different",
      "expression": "@2018-02-02T12:00:00.000 = @2018-02-02T12:00:00.001",
      "expected": [false],
      "tags": ["temporal", "equality", "milliseconds"]
    },
    {
      "name": "Time equality - same",
      "expression": "@T12:00 = @T12:00",
      "expected": [true],
      "tags": ["temporal", "equality", "time"]
    },
    {
      "name": "Time equality - different",
      "expression": "@T12:00 = @T13:00",
      "expected": [false],
      "tags": ["temporal", "equality", "time"]
    },
    {
      "name": "Time equality with seconds - same",
      "expression": "@T12:00:00 = @T12:00:00",
      "expected": [true],
      "tags": ["temporal", "equality", "time", "seconds"]
    },
    {
      "name": "Time equality with seconds - different",
      "expression": "@T12:00:00 = @T12:00:01",
      "expected": [false],
      "tags": ["temporal", "equality", "time", "seconds"]
    },
    {
      "name": "Date > comparison - false",
      "expression": "@2018 > @2019",
      "expected": [false],
      "tags": ["temporal", "comparison", "greater"]
    },
    {
      "name": "Date > comparison - true",
      "expression": "@2018 > @2017",
      "expected": [true],
      "tags": ["temporal", "comparison", "greater"]
    },
    {
      "name": "Date > comparison - different precision returns empty",
      "expression": "@2018-12-31 > @2018",
      "expected": [],
      "tags": ["temporal", "comparison", "precision"]
    },
    {
      "name": "Date > comparison - different precision when clear",
      "expression": "@2018 > @2017-01",
      "expected": [true],
      "tags": ["temporal", "comparison", "precision"]
    },
    {
      "name": "Date >= comparison - greater",
      "expression": "@2018 >= @2017",
      "expected": [true],
      "tags": ["temporal", "comparison", "greaterOrEqual"]
    },
    {
      "name": "Date >= comparison - equal",
      "expression": "@2018 >= @2018",
      "expected": [true],
      "tags": ["temporal", "comparison", "greaterOrEqual"]
    },
    {
      "name": "Date >= comparison - less",
      "expression": "@2018 >= @2019",
      "expected": [false],
      "tags": ["temporal", "comparison", "greaterOrEqual"]
    },
    {
      "name": "Date <= comparison - less",
      "expression": "@2018 <= @2017",
      "expected": [false],
      "tags": ["temporal", "comparison", "lessOrEqual"]
    },
    {
      "name": "Date <= comparison - equal",
      "expression": "@2018 <= @2018",
      "expected": [true],
      "tags": ["temporal", "comparison", "lessOrEqual"]
    },
    {
      "name": "Date <= comparison - greater",
      "expression": "@2018 <= @2019",
      "expected": [true],
      "tags": ["temporal", "comparison", "lessOrEqual"]
    },
    {
      "name": "Date < comparison - false when greater",
      "expression": "@2018 < @2017",
      "expected": [false],
      "tags": ["temporal", "comparison", "less"]
    },
    {
      "name": "Date < comparison - false when equal",
      "expression": "@2018 < @2018",
      "expected": [false],
      "tags": ["temporal", "comparison", "less"]
    },
    {
      "name": "Date < comparison - true",
      "expression": "@2018 < @2019",
      "expected": [true],
      "tags": ["temporal", "comparison", "less"]
    },
    {
      "name": "DateTime > comparison - equal",
      "expression": "@2018-12-21T12:01 > @2018-12-21T12:01",
      "expected": [false],
      "tags": ["temporal", "comparison", "datetime"]
    },
    {
      "name": "DateTime > comparison - less",
      "expression": "@2018-12-21T12:01 > @2018-12-21T12:02",
      "expected": [false],
      "tags": ["temporal", "comparison", "datetime"]
    },
    {
      "name": "DateTime > comparison - greater",
      "expression": "@2018-12-21T12:02 > @2018-12-21T12:01",
      "expected": [true],
      "tags": ["temporal", "comparison", "datetime"]
    },
    {
      "name": "DateTime > comparison - different days",
      "expression": "@2018-12-22T12:02 > @2018-12-21T12:01",
      "expected": [true],
      "tags": ["temporal", "comparison", "datetime"]
    },
    {
      "name": "DateTime > comparison - earlier day",
      "expression": "@2018-12-20T12:02 > @2018-12-21T12:01",
      "expected": [false],
      "tags": ["temporal", "comparison", "datetime"]
    },
    {
      "name": "DateTime > comparison - different precision",
      "expression": "@2018-12-20T12 > @2018-12-20T12:01",
      "expected": [],
      "tags": ["temporal", "comparison", "precision"]
    },
    {
      "name": "DateTime > comparison - hour precision clear comparison",
      "expression": "@2018-12-20T12 > @2018-12-20T11:01",
      "expected": [true],
      "tags": ["temporal", "comparison", "precision"]
    },
    {
      "name": "DateTime with timezone > comparison - 12:02+03:00 vs 12:01+02:00",
      "expression": "@2018-12-21T12:02+03:00 > @2018-12-21T12:01+02:00",
      "expected": [false],
      "tags": ["temporal", "comparison", "timezone"]
    },
    {
      "name": "DateTime with timezone > comparison - 12:02+02:00 vs 12:01+03:00",
      "expression": "@2018-12-21T12:02+02:00 > @2018-12-21T12:01+03:00",
      "expected": [true],
      "tags": ["temporal", "comparison", "timezone"]
    },
    {
      "name": "Add 1 year to date",
      "expression": "@2018 + 1 year",
      "expected": ["2019"],
      "tags": ["temporal", "arithmetic", "year"]
    },
    {
      "name": "Add 2 years to date",
      "expression": "@2018 + 2 years",
      "expected": ["2020"],
      "tags": ["temporal", "arithmetic", "year"]
    },
    {
      "name": "Add 1 month to date",
      "expression": "@2018-02 + 1 month",
      "expected": ["2018-03"],
      "tags": ["temporal", "arithmetic", "month"]
    },
    {
      "name": "Add 2 months to date",
      "expression": "@2018-02 + 2 months",
      "expected": ["2018-04"],
      "tags": ["temporal", "arithmetic", "month"]
    },
    {
      "name": "Add 11 months - precision preserved",
      "expression": "@2016 + 11 months",
      "expected": ["2016"],
      "tags": ["temporal", "arithmetic", "month", "precision"]
    },
    {
      "name": "Add 12 months - year changes",
      "expression": "@2016 + 12 months",
      "expected": ["2017"],
      "tags": ["temporal", "arithmetic", "month"]
    },
    {
      "name": "Add 364 days - year precision preserved",
      "expression": "@2016 + 364 days",
      "expected": ["2016"],
      "tags": ["temporal", "arithmetic", "day", "precision"]
    },
    {
      "name": "Add 365 days - year changes",
      "expression": "@2016 + 365 days",
      "expected": ["2017"],
      "tags": ["temporal", "arithmetic", "day"]
    },
    {
      "name": "Add 29 days to January - month precision preserved",
      "expression": "@2016-01 + 29 days",
      "expected": ["2016-01"],
      "tags": ["temporal", "arithmetic", "day", "precision"]
    },
    {
      "name": "Add 31 days to January - month changes",
      "expression": "@2016-01 + 31 days",
      "expected": ["2016-02"],
      "tags": ["temporal", "arithmetic", "day"]
    },
    {
      "name": "Subtract 364 days - year preserved",
      "expression": "@2016 - 364 days",
      "expected": ["2016"],
      "tags": ["temporal", "arithmetic", "subtraction", "precision"]
    },
    {
      "name": "Subtract 365 days - year changes",
      "expression": "@2016 - 365 days",
      "expected": ["2015"],
      "tags": ["temporal", "arithmetic", "subtraction"]
    },
    {
      "name": "Add 1 hour to DateTime",
      "expression": "@2018-01-01T00 + 1 hour",
      "expected": ["2018-01-01T01"],
      "tags": ["temporal", "arithmetic", "hour"]
    },
    {
      "name": "Add 90 minutes to DateTime",
      "expression": "@2018-01-01T00:00 + 90 minutes",
      "expected": ["2018-01-01T01:30"],
      "tags": ["temporal", "arithmetic", "minute"]
    },
    {
      "name": "Add 3661 seconds to DateTime",
      "expression": "@2018-01-01T00:00:00 + 3661 seconds",
      "expected": ["2018-01-01T01:01:01"],
      "tags": ["temporal", "arithmetic", "second"]
    },
    {
      "name": "Month-end adjustment - Jan 31 + 1 month (non-leap year)",
      "expression": "@2018-01-31 + 1 month",
      "expected": ["2018-02-28"],
      "tags": ["temporal", "arithmetic", "monthEnd"]
    },
    {
      "name": "Month-end adjustment - Jan 31 + 1 month (leap year)",
      "expression": "@2020-01-31 + 1 month",
      "expected": ["2020-02-29"],
      "tags": ["temporal", "arithmetic", "monthEnd", "leapYear"]
    },
    {
      "name": "Month-end adjustment - Mar 31 - 1 month",
      "expression": "@2018-03-31 - 1 month",
      "expected": ["2018-02-28"],
      "tags": ["temporal", "arithmetic", "monthEnd", "subtraction"]
    },
    {
      "name": "Year transition - Dec + 1 month",
      "expression": "@2018-12 + 1 month",
      "expected": ["2019-01"],
      "tags": ["temporal", "arithmetic", "yearTransition"]
    },
    {
      "name": "Year transition - Dec 31 + 1 day",
      "expression": "@2018-12-31 + 1 day",
      "expected": ["2019-01-01"],
      "tags": ["temporal", "arithmetic", "yearTransition"]
    },
    {
      "name": "Year transition - Jan - 1 month",
      "expression": "@2019-01 - 1 month",
      "expected": ["2018-12"],
      "tags": ["temporal", "arithmetic", "yearTransition", "subtraction"]
    },
    {
      "name": "Year transition - Jan 1 - 1 day",
      "expression": "@2019-01-01 - 1 day",
      "expected": ["2018-12-31"],
      "tags": ["temporal", "arithmetic", "yearTransition", "subtraction"]
    },
    {
      "name": "DateTime with UTC timezone arithmetic",
      "expression": "@2018-01-01T00:00:00Z + 1 hour",
      "expected": ["2018-01-01T01:00:00Z"],
      "tags": ["temporal", "arithmetic", "timezone", "UTC"]
    },
    {
      "name": "DateTime with offset timezone arithmetic",
      "expression": "@2018-01-01T00:00:00-05:00 + 1 hour",
      "expected": ["2018-01-01T01:00:00-05:00"],
      "tags": ["temporal", "arithmetic", "timezone", "offset"]
    },
    {
      "name": "Precision preservation - year + 6 months",
      "expression": "@2018 + 6 months",
      "expected": ["2018"],
      "tags": ["temporal", "arithmetic", "precision"]
    },
    {
      "name": "Precision preservation - year + 12 months",
      "expression": "@2018 + 12 months",
      "expected": ["2019"],
      "tags": ["temporal", "arithmetic", "precision"]
    },
    {
      "name": "Precision preservation - month + 15 days",
      "expression": "@2018-01 + 15 days",
      "expected": ["2018-01"],
      "tags": ["temporal", "arithmetic", "precision"]
    },
    {
      "name": "Precision preservation - month + 31 days",
      "expression": "@2018-01 + 31 days",
      "expected": ["2018-02"],
      "tags": ["temporal", "arithmetic", "precision"]
    },
    {
      "name": "Time + 2 hours",
      "expression": "@T10:00 + 2 hours",
      "expected": ["12:00"],
      "tags": ["temporal", "arithmetic", "time"]
    },
    {
      "name": "Time + 45 minutes",
      "expression": "@T10:30 + 45 minutes",
      "expected": ["11:15"],
      "tags": ["temporal", "arithmetic", "time"]
    },
    {
      "name": "Time wraparound forward",
      "expression": "@T23:00 + 2 hours",
      "expected": ["01:00"],
      "tags": ["temporal", "arithmetic", "time", "wraparound"]
    },
    {
      "name": "Time wraparound backward",
      "expression": "@T01:00 - 2 hours",
      "expected": ["23:00"],
      "tags": ["temporal", "arithmetic", "time", "wraparound"]
    },
    {
      "name": "Chained arithmetic operations",
      "expression": "@2018 + 1 year + 6 months",
      "expected": ["2019"],
      "tags": ["temporal", "arithmetic", "chained", "precision"]
    },
    {
      "name": "Arithmetic in comparison",
      "expression": "(@2018-01-15 + 20 days) > @2018-02-01",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "comparison"]
    },
    {
      "name": "Type check - Date.is(Date)",
      "expression": "@2018.is(Date)",
      "expected": [true],
      "tags": ["temporal", "type", "is"]
    },
    {
      "name": "Type check - Date.is(DateTime)",
      "expression": "@2018.is(DateTime)",
      "expected": [false],
      "tags": ["temporal", "type", "is"]
    },
    {
      "name": "Type check - DateTime.is(DateTime)",
      "expression": "@2018T.is(DateTime)",
      "expected": [true],
      "tags": ["temporal", "type", "is"]
    },
    {
      "name": "Type check - Time.is(Time)",
      "expression": "@T10:30.is(Time)",
      "expected": [true],
      "tags": ["temporal", "type", "is"]
    },
    {
      "name": "Type cast - Date.as(Date)",
      "expression": "@2018.as(Date).exists()",
      "expected": [true],
      "tags": ["temporal", "type", "as"]
    },
    {
      "name": "Type cast - Date.as(DateTime) returns empty",
      "expression": "@2018.as(DateTime)",
      "expected": [],
      "tags": ["temporal", "type", "as"]
    },
    {
      "name": "Type cast - DateTime.as(DateTime)",
      "expression": "@2018T.as(DateTime).exists()",
      "expected": [true],
      "tags": ["temporal", "type", "as"]
    },
    {
      "name": "Type cast - Time.as(Time)",
      "expression": "@T10:30.as(Time).exists()",
      "expected": [true],
      "tags": ["temporal", "type", "as"]
    },
    {
      "name": "Invalid operation - Date + non-time unit",
      "expression": "@2018 + 5 'liters'",
      "expected": [],
      "tags": ["temporal", "invalid"]
    },
    {
      "name": "Invalid operation - Time + calendar unit",
      "expression": "@T10:30 + 1 day",
      "expected": [],
      "tags": ["temporal", "invalid"]
    },
    {
      "name": "Boundary date - year 0001",
      "expression": "@0001",
      "expected": ["0001"],
      "tags": ["temporal", "boundary"]
    },
    {
      "name": "Boundary date - year 9999",
      "expression": "@9999",
      "expected": ["9999"],
      "tags": ["temporal", "boundary"]
    },
    {
      "name": "Boundary date - 0001-01-01",
      "expression": "@0001-01-01",
      "expected": ["0001-01-01"],
      "tags": ["temporal", "boundary"]
    },
    {
      "name": "Boundary date - 9999-12-31",
      "expression": "@9999-12-31",
      "expected": ["9999-12-31"],
      "tags": ["temporal", "boundary"]
    },
    {
      "name": "Leap year date",
      "expression": "@2020-02-29",
      "expected": ["2020-02-29"],
      "tags": ["temporal", "leapYear"]
    },
    {
      "name": "Leap year arithmetic - Feb 28 + 1 day",
      "expression": "@2020-02-28 + 1 day",
      "expected": ["2020-02-29"],
      "tags": ["temporal", "leapYear", "arithmetic"]
    },
    {
      "name": "Leap year arithmetic - Mar 1 - 1 day",
      "expression": "@2020-03-01 - 1 day",
      "expected": ["2020-02-29"],
      "tags": ["temporal", "leapYear", "arithmetic"]
    },
    {
      "name": "Non-leap year arithmetic - Feb 28 + 1 day",
      "expression": "@2019-02-28 + 1 day",
      "expected": ["2019-03-01"],
      "tags": ["temporal", "arithmetic"]
    },
    {
      "name": "Precision comparison - different precisions return empty",
      "expression": "@2018 > @2018-01",
      "expected": [],
      "tags": ["temporal", "comparison", "precision"]
    },
    {
      "name": "Precision comparison - different precisions return empty (reverse)",
      "expression": "@2018-01 < @2018",
      "expected": [],
      "tags": ["temporal", "comparison", "precision"]
    },
    {
      "name": "Precision comparison - clear comparison with different precisions",
      "expression": "@2018 > @2017-12",
      "expected": [true],
      "tags": ["temporal", "comparison", "precision"]
    },
    {
      "name": "Precision comparison - clear comparison with different precisions (2)",
      "expression": "@2018-01 < @2019",
      "expected": [true],
      "tags": ["temporal", "comparison", "precision"]
    }
  ]
}