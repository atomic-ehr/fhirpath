{
  "name": "Temporal Arithmetic Tests",
  "description": "Tests for arithmetic operations with temporal values",
  "tests": [
    {
      "name": "Date + days",
      "expression": "@2020-01-15 + 7 days",
      "expected": ["@2020-01-22"],
      "tags": ["temporal", "arithmetic", "date", "addition"]
    },
    {
      "name": "Date + months",
      "expression": "@2020-01-15 + 2 months",
      "expected": ["@2020-03-15"],
      "tags": ["temporal", "arithmetic", "date", "addition"]
    },
    {
      "name": "Date + years",
      "expression": "@2020-01-15 + 3 years",
      "expected": ["@2023-01-15"],
      "tags": ["temporal", "arithmetic", "date", "addition"]
    },
    {
      "name": "Date - days",
      "expression": "@2020-01-15 - 5 days",
      "expected": ["@2020-01-10"],
      "tags": ["temporal", "arithmetic", "date", "subtraction"]
    },
    {
      "name": "Date year rollover forward",
      "expression": "@1973-12-25 + 7 days",
      "expected": ["@1974-01-01"],
      "tags": ["temporal", "arithmetic", "date", "rollover"]
    },
    {
      "name": "Date year rollover backward",
      "expression": "@2020-01-05 - 10 days",
      "expected": ["@2019-12-26"],
      "tags": ["temporal", "arithmetic", "date", "rollover"]
    },
    {
      "name": "Date month-end adjustment - leap year",
      "expression": "@2020-01-31 + 1 month",
      "expected": ["@2020-02-29"],
      "tags": ["temporal", "arithmetic", "date", "month-end", "leap-year"]
    },
    {
      "name": "Date month-end adjustment - non-leap year",
      "expression": "@2019-01-31 + 1 month",
      "expected": ["@2019-02-28"],
      "tags": ["temporal", "arithmetic", "date", "month-end"]
    },
    {
      "name": "DateTime + hours",
      "expression": "@2020-01-15T10:30:00 + 5 hours",
      "expected": ["@2020-01-15T15:30:00"],
      "tags": ["temporal", "arithmetic", "datetime", "addition"]
    },
    {
      "name": "DateTime + minutes",
      "expression": "@2020-01-15T10:30:00 + 90 minutes",
      "expected": ["@2020-01-15T12:00:00"],
      "tags": ["temporal", "arithmetic", "datetime", "addition"]
    },
    {
      "name": "DateTime + seconds",
      "expression": "@2020-01-15T10:30:45 + 75 seconds",
      "expected": ["@2020-01-15T10:32:00"],
      "tags": ["temporal", "arithmetic", "datetime", "addition"]
    },
    {
      "name": "DateTime + milliseconds",
      "expression": "@2020-01-15T10:30:45.500 + 1500 milliseconds",
      "expected": ["@2020-01-15T10:30:47.000"],
      "tags": ["temporal", "arithmetic", "datetime", "milliseconds"]
    },
    {
      "name": "DateTime day rollover",
      "expression": "@2020-01-15T22:00:00 + 5 hours",
      "expected": ["@2020-01-16T03:00:00"],
      "tags": ["temporal", "arithmetic", "datetime", "rollover"]
    },
    {
      "name": "DateTime with timezone + hours",
      "expression": "@2020-01-15T10:30:00Z + 3 hours",
      "expected": ["@2020-01-15T13:30:00Z"],
      "tags": ["temporal", "arithmetic", "datetime", "timezone"]
    },
    {
      "name": "Time + hours",
      "expression": "@T10:30:00 + 2 hours",
      "expected": ["@T12:30:00"],
      "tags": ["temporal", "arithmetic", "time", "addition"]
    },
    {
      "name": "Time + minutes",
      "expression": "@T10:30 + 45 minutes",
      "expected": ["@T11:15"],
      "tags": ["temporal", "arithmetic", "time", "addition"]
    },
    {
      "name": "Time - hours",
      "expression": "@T10:30:00 - 3 hours",
      "expected": ["@T07:30:00"],
      "tags": ["temporal", "arithmetic", "time", "subtraction"]
    },
    {
      "name": "Time wraparound forward",
      "expression": "@T23:30:00 + 1 hour",
      "expected": ["@T00:30:00"],
      "tags": ["temporal", "arithmetic", "time", "wraparound"]
    },
    {
      "name": "Time wraparound backward",
      "expression": "@T01:30:00 - 2 hours",
      "expected": ["@T23:30:00"],
      "tags": ["temporal", "arithmetic", "time", "wraparound"]
    },
    {
      "name": "Precision preservation - year + months (coerced to 0)",
      "expression": "@2020T + 6 months",
      "expected": ["@2020T"],
      "tags": ["temporal", "arithmetic", "precision", "coercion"]
    },
    {
      "name": "Precision preservation - month + days (coerced to 0)",
      "expression": "@2020-01T + 15 days",
      "expected": ["@2020-01T"],
      "tags": ["temporal", "arithmetic", "precision", "coercion"]
    },
    {
      "name": "Invalid operation - Date + incorrect unit",
      "expression": "@2020-01-15 + 5 'liters'",
      "expected": [],
      "tags": ["temporal", "arithmetic", "invalid"]
    },
    {
      "name": "Invalid operation - Time + days",
      "expression": "@T10:30:00 + 1 day",
      "error": true,
      "tags": ["temporal", "arithmetic", "invalid"]
    },
    {
      "name": "Add 1 year to date",
      "expression": "@2018 + 1 year",
      "expected": ["@2019"],
      "tags": ["temporal", "arithmetic", "year"]
    },
    {
      "name": "Add 2 years to date",
      "expression": "@2018 + 2 years",
      "expected": ["@2020"],
      "tags": ["temporal", "arithmetic", "year"]
    },
    {
      "name": "Add 1 month to date",
      "expression": "@2018-02 + 1 month",
      "expected": ["@2018-03"],
      "tags": ["temporal", "arithmetic", "month"]
    },
    {
      "name": "Add 2 months to date",
      "expression": "@2018-02 + 2 months",
      "expected": ["@2018-04"],
      "tags": ["temporal", "arithmetic", "month"]
    },
    {
      "name": "Add 11 months - precision preserved",
      "expression": "@2016 + 11 months",
      "expected": ["@2016"],
      "tags": ["temporal", "arithmetic", "month", "precision"]
    },
    {
      "name": "Add 12 months - year changes",
      "expression": "@2016 + 12 months",
      "expected": ["@2017"],
      "tags": ["temporal", "arithmetic", "month"]
    },
    {
      "name": "Add 364 days - year precision preserved",
      "expression": "@2016 + 364 days",
      "expected": ["@2016"],
      "tags": ["temporal", "arithmetic", "day", "precision"]
    },
    {
      "name": "Add 365 days - year changes",
      "expression": "@2016 + 365 days",
      "expected": ["@2017"],
      "tags": ["temporal", "arithmetic", "day"]
    },
    {
      "name": "Add 29 days to January - month precision preserved",
      "expression": "@2016-01 + 29 days",
      "expected": ["@2016-01"],
      "tags": ["temporal", "arithmetic", "day", "precision"]
    },
    {
      "name": "Add 31 days to January - month changes",
      "expression": "@2016-01 + 31 days",
      "expected": ["@2016-02"],
      "tags": ["temporal", "arithmetic", "day"]
    },
    {
      "name": "Subtract 364 days - year preserved",
      "expression": "@2016 - 364 days",
      "expected": ["@2016"],
      "tags": ["temporal", "arithmetic", "subtraction", "precision"]
    },
    {
      "name": "Subtract 365 days - year changes",
      "expression": "@2016 - 365 days",
      "expected": ["@2015"],
      "tags": ["temporal", "arithmetic", "subtraction"]
    },
    {
      "name": "Add 1 hour to DateTime",
      "expression": "@2018-01-01T00 + 1 hour",
      "expected": ["@2018-01-01T01"],
      "tags": ["temporal", "arithmetic", "hour"]
    },
    {
      "name": "Add 90 minutes to DateTime",
      "expression": "@2018-01-01T00:00 + 90 minutes",
      "expected": ["@2018-01-01T01:30"],
      "tags": ["temporal", "arithmetic", "minute"]
    },
    {
      "name": "Add 3661 seconds to DateTime",
      "expression": "@2018-01-01T00:00:00 + 3661 seconds",
      "expected": ["@2018-01-01T01:01:01"],
      "tags": ["temporal", "arithmetic", "second"]
    },
    {
      "name": "Month-end adjustment - Jan 31 + 1 month (non-leap year)",
      "expression": "@2018-01-31 + 1 month",
      "expected": ["@2018-02-28"],
      "tags": ["temporal", "arithmetic", "monthEnd"]
    },
    {
      "name": "Month-end adjustment - Jan 31 + 1 month (leap year)",
      "expression": "@2020-01-31 + 1 month",
      "expected": ["@2020-02-29"],
      "tags": ["temporal", "arithmetic", "monthEnd", "leapYear"]
    },
    {
      "name": "Month-end adjustment - Mar 31 - 1 month",
      "expression": "@2018-03-31 - 1 month",
      "expected": ["@2018-02-28"],
      "tags": ["temporal", "arithmetic", "monthEnd", "subtraction"]
    },
    {
      "name": "Year transition - Dec + 1 month",
      "expression": "@2018-12 + 1 month",
      "expected": ["@2019-01"],
      "tags": ["temporal", "arithmetic", "yearTransition"]
    },
    {
      "name": "Year transition - Dec 31 + 1 day",
      "expression": "@2018-12-31 + 1 day",
      "expected": ["@2019-01-01"],
      "tags": ["temporal", "arithmetic", "yearTransition"]
    },
    {
      "name": "Year transition - Jan - 1 month",
      "expression": "@2019-01 - 1 month",
      "expected": ["@2018-12"],
      "tags": ["temporal", "arithmetic", "yearTransition", "subtraction"]
    },
    {
      "name": "Year transition - Jan 1 - 1 day",
      "expression": "@2019-01-01 - 1 day",
      "expected": ["@2018-12-31"],
      "tags": ["temporal", "arithmetic", "yearTransition", "subtraction"]
    },
    {
      "name": "DateTime with UTC timezone arithmetic",
      "expression": "@2018-01-01T00:00:00Z + 1 hour",
      "expected": ["@2018-01-01T01:00:00Z"],
      "tags": ["temporal", "arithmetic", "timezone", "UTC"]
    },
    {
      "name": "DateTime with offset timezone arithmetic",
      "expression": "@2018-01-01T00:00:00-05:00 + 1 hour",
      "expected": ["@2018-01-01T01:00:00-05:00"],
      "tags": ["temporal", "arithmetic", "timezone", "offset"]
    },
    {
      "name": "Precision preservation - year + 6 months",
      "expression": "@2018 + 6 months",
      "expected": ["@2018"],
      "tags": ["temporal", "arithmetic", "precision"]
    },
    {
      "name": "Precision preservation - year + 12 months",
      "expression": "@2018 + 12 months",
      "expected": ["@2019"],
      "tags": ["temporal", "arithmetic", "precision"]
    },
    {
      "name": "Precision preservation - month + 15 days",
      "expression": "@2018-01 + 15 days",
      "expected": ["@2018-01"],
      "tags": ["temporal", "arithmetic", "precision"]
    },
    {
      "name": "Precision preservation - month + 31 days",
      "expression": "@2018-01 + 31 days",
      "expected": ["@2018-02"],
      "tags": ["temporal", "arithmetic", "precision"]
    },
    {
      "name": "Time + 2 hours",
      "expression": "@T10:00 + 2 hours",
      "expected": ["@T12:00"],
      "tags": ["temporal", "arithmetic", "time"]
    },
    {
      "name": "Time + 45 minutes",
      "expression": "@T10:30 + 45 minutes",
      "expected": ["@T11:15"],
      "tags": ["temporal", "arithmetic", "time"]
    },
    {
      "name": "Time wraparound forward",
      "expression": "@T23:00 + 2 hours",
      "expected": ["@T01:00"],
      "tags": ["temporal", "arithmetic", "time", "wraparound"]
    },
    {
      "name": "Time wraparound backward",
      "expression": "@T01:00 - 2 hours",
      "expected": ["@T23:00"],
      "tags": ["temporal", "arithmetic", "time", "wraparound"]
    },
    {
      "name": "Chained arithmetic operations",
      "expression": "@2018 + 1 year + 6 months",
      "expected": ["@2019"],
      "tags": ["temporal", "arithmetic", "chained", "precision"]
    },
    {
      "name": "Arithmetic in comparison",
      "expression": "(@2018-01-15 + 20 days) > @2018-02-01",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "comparison"]
    },
    {
      "name": "Invalid operation - Date + non-time unit",
      "expression": "@2018 + 5 'liters'",
      "expected": [],
      "tags": ["temporal", "invalid", "arithmetic"]
    },
    {
      "name": "Invalid operation - Time + calendar unit",
      "expression": "@T10:30 + 1 day",
      "error": true,
      "tags": ["temporal", "invalid", "arithmetic"]
    },
    {
      "name": "Leap year arithmetic - Feb 28 + 1 day",
      "expression": "@2020-02-28 + 1 day",
      "expected": ["@2020-02-29"],
      "tags": ["temporal", "leapYear", "arithmetic"]
    },
    {
      "name": "Leap year arithmetic - Mar 1 - 1 day",
      "expression": "@2020-03-01 - 1 day",
      "expected": ["@2020-02-29"],
      "tags": ["temporal", "leapYear", "arithmetic"]
    },
    {
      "name": "Non-leap year arithmetic - Feb 28 + 1 day",
      "expression": "@2019-02-28 + 1 day",
      "expected": ["@2019-03-01"],
      "tags": ["temporal", "arithmetic"]
    },
    {
      "name": "Invalid - year literal with abbreviated unit",
      "expression": "@2018 + 1 'a'",
      "expected": [],
      "tags": ["temporal", "arithmetic", "error", "abbreviation"]
    },
    {
      "name": "Invalid - month literal with abbreviated unit",
      "expression": "@2018-02 + 1 'mo'",
      "expected": [],
      "tags": ["temporal", "arithmetic", "error", "abbreviation"]
    },
    {
      "name": "Valid - day literal with UCUM unit 'd'",
      "expression": "@2016-01 + 29 'd'",
      "expected": ["@2016-01"],
      "tags": ["temporal", "arithmetic", "ucum", "day"]
    },
    {
      "name": "Valid - day literal with UCUM unit 'd' (30 days)",
      "expression": "@2016-01 + 30 'd'",
      "expected": ["@2016-02"],
      "tags": ["temporal", "arithmetic", "ucum", "day"]
    },
    {
      "name": "Add 30 days to January - month changes",
      "expression": "@2016-01 + 30 days",
      "expected": ["@2016-02"],
      "tags": ["temporal", "arithmetic", "day"]
    },
    {
      "name": "Add 1 hour to month precision - invalid for Date",
      "expression": "@2016-01 + 1 hour",
      "error": { "code": "FP6011" },
      "tags": ["temporal", "arithmetic", "precision", "hour", "error"]
    },
    {
      "name": "Add 2 years to full date",
      "expression": "@2018-01-03 + 2 years",
      "expected": ["@2020-01-03"],
      "tags": ["temporal", "arithmetic", "date", "year"]
    },
    {
      "name": "Add 2 years to DateTime with timezone",
      "expression": "@2018-02-18T12:23:45-05:00 + 2 years",
      "expected": ["@2020-02-18T12:23:45-05:00"],
      "tags": ["temporal", "arithmetic", "datetime", "timezone"]
    },
    {
      "name": "Add 1 month to Feb 29 - leap year",
      "expression": "@2016-02-29 + 1 month",
      "expected": ["@2016-03-29"],
      "tags": ["temporal", "arithmetic", "leapYear", "monthEnd"]
    },
    {
      "name": "Add 1 year to Feb 29 - non-leap year adjustment",
      "expression": "@2016-02-29 + 1 year",
      "expected": ["@2017-02-28"],
      "tags": ["temporal", "arithmetic", "leapYear", "yearAdjustment"]
    },
    {
      "name": "Invalid - quantity + date (non-commutative)",
      "expression": "1 year + @2016-02-29",
      "error": true,
      "tags": ["temporal", "arithmetic", "error", "nonCommutative"]
    },
    {
      "name": "Invalid - date plus date",
      "expression": "@2016-02-29 + @2016-02-29",
      "error": true,
      "tags": ["temporal", "arithmetic", "error", "invalidOperation"]
    },
    {
      "name": "Invalid - quantity minus date",
      "expression": "1 year - @2016-02-29",
      "error": true,
      "tags": ["temporal", "arithmetic", "error", "invalidOperation"]
    },
    {
      "name": "Quantity multiplication",
      "expression": "1 year * 2 = 2 year",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "quantity", "multiplication"]
    },
    {
      "name": "Quantity multiplication - commutative",
      "expression": "2 * 5 months = 10 months",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "quantity", "multiplication"]
    },
    {
      "name": "Quantity division - calendar units error",
      "expression": "1 year / 6 months",
      "error": true,
      "description": "Calendar duration units cannot be divided",
      "tags": ["temporal", "arithmetic", "quantity", "division", "error"]
    },
    {
      "name": "Month end adjustment - Jan 31 + 1 month + 1 day",
      "expression": "@2016-01-31 + 1 month + 1 day",
      "expected": ["@2016-03-01"],
      "tags": ["temporal", "arithmetic", "monthEnd", "chain"]
    },
    {
      "name": "Add 1 week to date",
      "expression": "@2016-02-28 + 1 week",
      "expected": ["@2016-03-06"],
      "tags": ["temporal", "arithmetic", "week"]
    },
    {
      "name": "Valid - week literal with UCUM unit 'wk'",
      "expression": "@2016-02-28 + 1 'wk'",
      "expected": ["@2016-03-06"],
      "tags": ["temporal", "arithmetic", "ucum", "week"]
    },
    {
      "name": "Add 2 days to Feb 28 (leap year)",
      "expression": "@2016-02-28 + 2 days",
      "expected": ["@2016-03-01"],
      "tags": ["temporal", "arithmetic", "leapYear"]
    },
    {
      "name": "Subtract 2 days from Feb 28",
      "expression": "@2016-02-28 - 2 days",
      "expected": ["@2016-02-26"],
      "tags": ["temporal", "arithmetic", "subtraction"]
    },
    {
      "name": "Add 24 hours to date - invalid for Date",
      "expression": "@2016-01-01 + 24 hours",
      "error": { "code": "FP6011" },
      "tags": ["temporal", "arithmetic", "hours", "dayRollover", "error"]
    },
    {
      "name": "Add 47 hours to date - invalid for Date",
      "expression": "@2016-01-01 + 47 hours",
      "error": { "code": "FP6011" },
      "tags": ["temporal", "arithmetic", "hours", "precision", "error"]
    },
    {
      "name": "Add 59 minutes to DateTime hour - no change",
      "expression": "@2018-02-18T12 + 59 minutes = @2018-02-18T12",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "minutes", "precision"]
    },
    {
      "name": "Add 60 minutes to DateTime hour - hour changes",
      "expression": "@2018-02-18T12 + 60 minutes = @2018-02-18T13",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "minutes", "hourRollover"]
    },
    {
      "name": "Add 59 seconds to DateTime minute - no change",
      "expression": "@2018-02-18T12:00 + 59 seconds = @2018-02-18T12:00",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "seconds", "precision"]
    },
    {
      "name": "Add 60 seconds to DateTime minute - minute changes",
      "expression": "@2018-02-18T12:00 + 60 seconds = @2018-02-18T12:01",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "seconds", "minuteRollover"]
    },
    {
      "name": "Invalid - Time plus years",
      "expression": "@T09:45:23 + 2 years",
      "error": true,
      "tags": ["temporal", "arithmetic", "error", "invalidUnit"]
    },
    {
      "name": "Time plus 120 seconds",
      "expression": "@T09:45 + 120 seconds = @T09:47",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "time", "seconds"]
    },
    {
      "name": "Time plus 59 seconds - no minute change",
      "expression": "@T09:45 + 59 seconds = @T09:45",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "time", "seconds", "precision"]
    },
    {
      "name": "Time plus 2 minutes with milliseconds",
      "expression": "@T09:45:23 + 2 minutes = @T09:47:23.000",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "time", "minutes"]
    },
    {
      "name": "Time wraparound - 23:59 + 2 minutes",
      "expression": "@T23:59:23 + 2 minutes = @T00:01:23",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "time", "wraparound"]
    },
    {
      "name": "Invalid - Time plus days",
      "expression": "@T23:59:23 + 2 days",
      "error": true,
      "tags": ["temporal", "arithmetic", "error", "invalidUnit"]
    },
    {
      "name": "Time plus 5 milliseconds",
      "expression": "@T23:59:23 + 5 milliseconds = @T23:59:23.005",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "time", "milliseconds"]
    },
    {
      "name": "Time plus 1.5 seconds",
      "expression": "@T23:59:23 + 1.5 seconds = @T23:59:24.500",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "time", "decimal", "seconds"]
    },
    {
      "name": "Time plus 1.5 's' literal",
      "expression": "@T23:59:23 + 1.5 's' = @T23:59:24.500",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "time", "decimal", "literal"]
    },
    {
      "name": "Time minus 1.5 's' literal",
      "expression": "@T23:59:23 - 1.5 's' = @T23:59:21.500",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "time", "subtraction", "decimal"]
    },
    {
      "name": "Time plus 1000 milliseconds",
      "expression": "@T23:59:23 + 1000 milliseconds = @T23:59:24",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "time", "milliseconds"]
    },
    {
      "name": "Time plus 995 milliseconds with existing ms",
      "expression": "@T23:59:23.005 + 995 milliseconds = @T23:59:24",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "time", "milliseconds"]
    },
    {
      "name": "Time plus 1990 milliseconds with existing ms",
      "expression": "@T23:59:23.005 + 1990 milliseconds = @T23:59:24.995",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "time", "milliseconds"]
    },
    {
      "name": "Decimal year ignored for calendar precision",
      "expression": "@2016-02-29 + 1.5 year",
      "expected": ["@2017-02-28"],
      "tags": ["temporal", "arithmetic", "decimal", "precision"]
    },
    {
      "name": "Decimal weeks ignored for calendar precision",
      "expression": "@2016-02-28 + 1.5 weeks",
      "expected": ["@2016-03-06"],
      "tags": ["temporal", "arithmetic", "decimal", "weeks"]
    },
    {
      "name": "Decimal weeks subtraction",
      "expression": "@2016-02-28 - 1.5 weeks",
      "expected": ["@2016-02-21"],
      "tags": ["temporal", "arithmetic", "decimal", "weeks", "subtraction"]
    },
    {
      "name": "Valid - decimal weeks with UCUM unit 'wk'",
      "expression": "@2016-02-28 + 1.5 'wk'",
      "expected": ["@2016-03-06"],
      "tags": ["temporal", "arithmetic", "ucum", "week", "decimal"]
    },
    {
      "name": "Decimal days ignored for calendar precision",
      "expression": "@2016-02-28 + 1.5 day",
      "expected": ["@2016-02-29"],
      "tags": ["temporal", "arithmetic", "decimal", "days"]
    },
    {
      "name": "Time plus 1.5 hours",
      "expression": "@T23:59:23 + 1.5 hours = @T00:59:23",
      "expected": [true],
      "tags": ["temporal", "arithmetic", "time", "decimal", "hours", "wraparound"]
    }
  ]
}
