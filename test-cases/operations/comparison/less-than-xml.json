{
  "name": "Less-Than (<) Tests from XML",
  "description": "Tests for the less-than (<) operator extracted from fhirpathlab-tests.xml",
  "tests": [
    {
      "name": "Integer comparison - 1 < 2",
      "expression": "1 < 2",
      "expected": [true],
      "tags": ["comparison", "less-than", "integer"],
      "fromXML": "testLessThan1"
    },
    {
      "name": "Decimal comparison - 1.0 < 1.2",
      "expression": "1.0 < 1.2",
      "expected": [true],
      "tags": ["comparison", "less-than", "decimal"],
      "fromXML": "testLessThan2"
    },
    {
      "name": "String comparison - 'a' < 'b'",
      "expression": "'a' < 'b'",
      "expected": [true],
      "tags": ["comparison", "less-than", "string"],
      "fromXML": "testLessThan3"
    },
    {
      "name": "Case sensitive string comparison - 'A' < 'a'",
      "expression": "'A' < 'a'",
      "expected": [true],
      "tags": ["comparison", "less-than", "string", "case-sensitive"],
      "fromXML": "testLessThan4"
    },
    {
      "name": "Date comparison - earlier date",
      "expression": "@2014-12-12 < @2014-12-13",
      "expected": [true],
      "tags": ["comparison", "less-than", "date", "temporal"],
      "fromXML": "testLessThan5"
    },
    {
      "name": "DateTime comparison - earlier datetime",
      "expression": "@2014-12-13T12:00:00 < @2014-12-13T12:00:01",
      "expected": [true],
      "tags": ["comparison", "less-than", "datetime", "temporal"],
      "fromXML": "testLessThan6"
    },
    {
      "name": "Time comparison - earlier time",
      "expression": "@T12:00:00 < @T14:00:00",
      "expected": [true],
      "tags": ["comparison", "less-than", "time", "temporal"],
      "fromXML": "testLessThan7"
    },
    {
      "name": "Integer equality - not less than",
      "expression": "1 < 1",
      "expected": [false],
      "tags": ["comparison", "less-than", "integer", "equality"],
      "fromXML": "testLessThan8"
    },
    {
      "name": "Decimal equality - not less than",
      "expression": "1.0 < 1.0",
      "expected": [false],
      "tags": ["comparison", "less-than", "decimal", "equality"],
      "fromXML": "testLessThan9"
    },
    {
      "name": "String equality - not less than",
      "expression": "'a' < 'a'",
      "expected": [false],
      "tags": ["comparison", "less-than", "string", "equality"],
      "fromXML": "testLessThan10"
    },
    {
      "name": "Uppercase string equality - not less than",
      "expression": "'A' < 'A'",
      "expected": [false],
      "tags": ["comparison", "less-than", "string", "equality"],
      "fromXML": "testLessThan11"
    },
    {
      "name": "Date equality - not less than",
      "expression": "@2014-12-12 < @2014-12-12",
      "expected": [false],
      "tags": ["comparison", "less-than", "date", "temporal", "equality"],
      "fromXML": "testLessThan12"
    },
    {
      "name": "DateTime equality - not less than",
      "expression": "@2014-12-13T12:00:00 < @2014-12-13T12:00:00",
      "expected": [false],
      "tags": ["comparison", "less-than", "datetime", "temporal", "equality"],
      "fromXML": "testLessThan13"
    },
    {
      "name": "Time equality - not less than",
      "expression": "@T12:00:00 < @T12:00:00",
      "expected": [false],
      "tags": ["comparison", "less-than", "time", "temporal", "equality"],
      "fromXML": "testLessThan14"
    },
    {
      "name": "Integer comparison - 2 not less than 1",
      "expression": "2 < 1",
      "expected": [false],
      "tags": ["comparison", "less-than", "integer"],
      "fromXML": "testLessThan15"
    },
    {
      "name": "Decimal comparison - 1.1 not less than 1.0",
      "expression": "1.1 < 1.0",
      "expected": [false],
      "tags": ["comparison", "less-than", "decimal"],
      "fromXML": "testLessThan16"
    },
    {
      "name": "String comparison - 'b' not less than 'a'",
      "expression": "'b' < 'a'",
      "expected": [false],
      "tags": ["comparison", "less-than", "string"],
      "fromXML": "testLessThan17"
    },
    {
      "name": "Case sensitive string comparison - 'B' not less than 'A'",
      "expression": "'B' < 'A'",
      "expected": [false],
      "tags": ["comparison", "less-than", "string", "case-sensitive"],
      "fromXML": "testLessThan18"
    },
    {
      "name": "Date comparison - later date not less than earlier",
      "expression": "@2014-12-13 < @2014-12-12",
      "expected": [false],
      "tags": ["comparison", "less-than", "date", "temporal"],
      "fromXML": "testLessThan19"
    },
    {
      "name": "DateTime comparison - later datetime not less than earlier",
      "expression": "@2014-12-13T12:00:01 < @2014-12-13T12:00:00",
      "expected": [false],
      "tags": ["comparison", "less-than", "datetime", "temporal"],
      "fromXML": "testLessThan20"
    },
    {
      "name": "Time comparison - later time not less than earlier",
      "expression": "@T12:00:01 < @T12:00:00",
      "expected": [false],
      "tags": ["comparison", "less-than", "time", "temporal"],
      "fromXML": "testLessThan21"
    },
    {
      "name": "Quantity comparison with observation data",
      "expression": "Observation.value < 200 '[lb_av]'",
      "inputFile": "../../input/observation-example.json",
      "expected": [true],
      "tags": ["comparison", "less-than", "quantity", "fhir"],
      "fromXML": "testLessThan22"
    },
    {
      "name": "Partial date comparison - incomparable precision",
      "expression": "@2018-03 < @2018-03-01",
      "expected": [],
      "tags": ["comparison", "less-than", "date", "temporal", "precision"],
      "fromXML": "testLessThan23"
    },
    {
      "name": "Partial datetime comparison - incomparable precision",
      "expression": "@2018-03-01T10:30 < @2018-03-01T10:30:00",
      "expected": [],
      "tags": ["comparison", "less-than", "datetime", "temporal", "precision"],
      "fromXML": "testLessThan24"
    },
    {
      "name": "Partial time comparison - incomparable precision",
      "expression": "@T10:30 < @T10:30:00",
      "expected": [],
      "tags": ["comparison", "less-than", "time", "temporal", "precision"],
      "fromXML": "testLessThan25"
    },
    {
      "name": "DateTime with milliseconds - precise equality",
      "expression": "@2018-03-01T10:30:00 < @2018-03-01T10:30:00.0",
      "expected": [false],
      "tags": ["comparison", "less-than", "datetime", "temporal", "milliseconds"],
      "fromXML": "testLessThan26"
    },
    {
      "name": "Time with milliseconds - precise equality",
      "expression": "@T10:30:00 < @T10:30:00.0",
      "expected": [false],
      "tags": ["comparison", "less-than", "time", "temporal", "milliseconds"],
      "fromXML": "testLessThan27"
    },
    {
      "name": "Integer vs empty collection",
      "expression": "1 < {}",
      "expected": [],
      "tags": ["comparison", "less-than", "empty", "collection"],
      "fromXML": "testLessThanEmpty1"
    },
    {
      "name": "Empty collection vs integer",
      "expression": "{} < 1",
      "expected": [],
      "tags": ["comparison", "less-than", "empty", "collection"],
      "fromXML": "testLessThanEmpty2"
    },
    {
      "name": "Empty collection vs empty collection",
      "expression": "{} < {}",
      "expected": [],
      "tags": ["comparison", "less-than", "empty", "collection"],
      "fromXML": "testLessThanEmpty3"
    }
  ]
}