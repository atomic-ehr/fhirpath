{
  "name": "lowBoundary",
  "description": "Tests for the lowBoundary() function - returns the least possible value to the specified precision",
  "sources": ["spec/sections-meta/§5.8.1-lowboundary-precision-decimal-date-datetime-time.json", "spec/fhirpathlab-tests/fhirpathlab-tests.xml"],
  "tags": ["function", "utility", "precision", "decimal", "integer", "temporal"],
  "tests": [
    {
      "title": "Decimal with default precision",
      "expression": "1.587.lowBoundary()",
      "expected": [1.5865],
      "description": "Returns 1.5865 for 1.587 with default precision (3)"
    },
    {
      "title": "Decimal with precision 2",
      "expression": "1.587.lowBoundary(2)",
      "expected": [1.5750000000000002],
      "description": "Returns 1.575 for 1.587 truncated to precision 2 minus half step"
    },
    {
      "title": "Integer with precision 0",
      "expression": "1.lowBoundary(0)",
      "expected": [0],
      "description": "Returns 0 for integer 1 at precision 0"
    },
    {
      "title": "Integer with precision 5",
      "expression": "1.lowBoundary(5)",
      "expected": [0.5],
      "description": "Returns 0.5 for integer 1 at precision 5"
    },
    {
      "title": "Negative decimal with precision 2",
      "expression": "(-1.587).lowBoundary(2)",
      "expected": [-1.595],
      "description": "Returns -1.595 for -1.587 truncated to precision 2 minus half step"
    },
    {
      "title": "Negative integer with precision 0",
      "expression": "(-1).lowBoundary(0)",
      "expected": [-2],
      "description": "Returns -2 for integer -1 at precision 0"
    },
    {
      "title": "Zero with precision 1",
      "expression": "0.lowBoundary(1)",
      "expected": [-0.5],
      "description": "Returns -0.5 for 0 at precision 1"
    },
    {
      "title": "Large decimal with default precision",
      "expression": "123.456789.lowBoundary()",
      "expected": [123.4567885],
      "description": "Returns value with default precision based on input"
    },
    {
      "title": "Small decimal with precision 8",
      "expression": "0.00000001.lowBoundary(8)",
      "expected": [0.000000005],
      "description": "Returns value adjusted by half step at precision 8"
    },
    {
      "title": "Invalid precision (negative)",
      "expression": "1.587.lowBoundary(-1)",
      "expected": [],
      "description": "Returns empty for invalid negative precision"
    },
    {
      "title": "Invalid precision (> 8)",
      "expression": "1.587.lowBoundary(9)",
      "expected": [],
      "description": "Returns empty for precision exceeding maximum (8)"
    },
    {
      "title": "Empty input",
      "expression": "{}.lowBoundary()",
      "expected": [],
      "description": "Returns empty for empty input"
    },
    {
      "title": "Non-numeric input",
      "expression": "'hello'.lowBoundary()",
      "expected": [],
      "description": "Returns empty for non-numeric input"
    }
  ]
}