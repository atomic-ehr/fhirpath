{
  "description": "Tests for dateOf() function",
  "tests": [
    {
      "name": "dateOf() on DateTime returns Date",
      "expression": "@2012-01-01T12:30:00.000-07:00.dateOf()",
      "input": [{}],
      "expected": ["@2012-01-01"]
    },
    {
      "name": "dateOf() on DateTime with partial precision",
      "expression": "@2012-01-01T12:30.dateOf()",
      "input": [{}],
      "expected": ["@2012-01-01"]
    },
    {
      "name": "dateOf() on Date returns same Date",
      "expression": "@2012-01-01.dateOf()",
      "input": [{}],
      "expected": ["@2012-01-01"]
    },
    {
      "name": "dateOf() on partial Date",
      "expression": "@2012-01.dateOf()",
      "input": [{}],
      "expected": ["@2012-01"]
    },
    {
      "name": "dateOf() on year-only Date",
      "expression": "@2012.dateOf()",
      "input": [{}],
      "expected": ["@2012"]
    },
    {
      "name": "dateOf() on empty returns empty",
      "expression": "{}.dateOf()",
      "input": [{}],
      "expected": []
    },
    {
      "name": "dateOf() on multiple items throws error",
      "expression": "(1 | 2).dateOf()",
      "input": [{}],
      "error": {
        "type": "Error",
        "code": "FP3006"
      }
    },
    {
      "name": "dateOf() on non-Date/DateTime returns empty",
      "expression": "'not a date'.dateOf()",
      "input": [{}],
      "expected": []
    },
    {
      "name": "dateOf() on Integer returns empty",
      "expression": "42.dateOf()",
      "input": [{}],
      "expected": []
    },
    {
      "name": "dateOf() preserves DateTime partial precision",
      "expression": "@2012-01-01T.dateOf()",
      "input": [{}],
      "expected": ["@2012-01-01"]
    },
    {
      "name": "dateOf() on DateTime with timezone",
      "expression": "@2012-01-01T12:30:00.000+05:30.dateOf()",
      "input": [{}],
      "expected": ["@2012-01-01"]
    },
    {
      "name": "dateOf() result is Date type",
      "expression": "@2012-01-01T12:30:00.dateOf().is(Date)",
      "input": [{}],
      "expected": [true]
    }
  ]
}