{
  "name": "DefineVariable Complex (XML tests)",
  "description": "Complex tests for defineVariable() function ported from XML test suite",
  "tests": [
    {
      "name": "defineVariable14: multiple variables with union",
      "expression": "Patient.name.defineVariable('n1', first()).select(%n1).exists() | Patient.name.defineVariable('n2', skip(1).first()).defineVariable('res', %n2.given+%n2.given).select(%res)",
      "inputFile": "../../input/patient-example.json",
      "expected": [true, "JimJim"],
      "fromXML": "defineVariable14",
      "tags": ["utility", "defineVariable", "variables", "union"]
    },
    {
      "name": "dvConceptMapExample: nested defineVariable",
      "expression": "group.select(\n  defineVariable('grp')\n  .element\n  .select(\n    defineVariable('ele')\n    .target\n    .select(%grp.source & '|' & %ele.code & ' ' & relationship & ' ' & %grp.target & '|' & code)\n  )\n)\n.trace('all')\n.isDistinct()",
      "inputFile": "../../input/conceptmap.json",
      "expected": [false],
      "fromXML": "dvConceptMapExample",
      "tags": ["utility", "defineVariable", "variables", "nested"]
    }
  ]
}