{
  "description": "Tests for highBoundary() function",
  "tests": [
    {
      "name": "Date year-only with default precision",
      "expression": "@2014.highBoundary()",
      "input": [{}],
      "expected": ["@2014-12-31"]
    },
    {
      "name": "Date year-only with month precision",
      "expression": "@2014.highBoundary(6)",
      "input": [{}],
      "expected": ["@2014-12"]
    },
    {
      "name": "Date February in leap year",
      "expression": "@2020-02.highBoundary(8)",
      "input": [{}],
      "expected": ["@2020-02-29"]
    },
    {
      "name": "Date February in non-leap year",
      "expression": "@2021-02.highBoundary(8)",
      "input": [{}],
      "expected": ["@2021-02-28"]
    },
    {
      "name": "Date April (30-day month)",
      "expression": "@2021-04.highBoundary(8)",
      "input": [{}],
      "expected": ["@2021-04-30"]
    },
    {
      "name": "DateTime with hour only, default precision",
      "expression": "@2014-01-01T08.highBoundary()",
      "input": [{}],
      "expected": ["@2014-01-01T08:59:59.999-12:00"]
    },
    {
      "name": "DateTime with hour only, day precision",
      "expression": "@2014-01-01T08.highBoundary(8)",
      "input": [{}],
      "expected": ["@2014-01-01"]
    },
    {
      "name": "DateTime with timezone",
      "expression": "@2014-01-01T08:05-05:00.highBoundary(17)",
      "input": [{}],
      "expected": ["@2014-01-01T08:05:59.999-05:00"]
    },
    {
      "name": "DateTime without timezone, millisecond precision",
      "expression": "@2014-01-01T08.highBoundary(17)",
      "input": [{}],
      "expected": ["@2014-01-01T08:59:59.999-12:00"]
    },
    {
      "name": "Time with hour and minute",
      "expression": "@T10:30.highBoundary()",
      "input": [{}],
      "expected": ["@T10:30:59.999"]
    },
    {
      "name": "Time with minute precision",
      "expression": "@T10:30.highBoundary(5)",
      "input": [{}],
      "expected": ["@T10:30"]
    },
    {
      "name": "Time with second precision",
      "expression": "@T10:30.highBoundary(7)",
      "input": [{}],
      "expected": ["@T10:30:59"]
    },
    {
      "name": "Invalid precision returns empty",
      "expression": "@T10:30.highBoundary(10)",
      "input": [{}],
      "expected": []
    },
    {
      "name": "Negative precision returns empty",
      "expression": "@2014.highBoundary(-1)",
      "input": [{}],
      "expected": []
    },
    {
      "name": "Empty input returns empty",
      "expression": "{}.highBoundary()",
      "input": [{}],
      "expected": []
    },
    {
      "name": "Multiple items throws error",
      "expression": "(@2014 | @2015).highBoundary()",
      "input": [{}],
      "error": {
        "message": "Cannot apply highBoundary",
        "phase": "analyze"
      }
    },
    {
      "name": "String input returns empty",
      "expression": "'not a date'.highBoundary()",
      "input": [{}],
      "expected": []
    },
    {
      "name": "Integer input returns empty",
      "expression": "42.highBoundary()",
      "input": [{}],
      "expected": []
    },
    {
      "name": "Complete date preserves value",
      "expression": "@2014-03-15.highBoundary(8)",
      "input": [{}],
      "expected": ["@2014-03-15"]
    },
    {
      "name": "Complete time preserves value",
      "expression": "@T10:30:45.123.highBoundary(9)",
      "input": [{}],
      "expected": ["@T10:30:45.123"]
    },
    {
      "name": "Year 1900 February (not leap year)",
      "expression": "@1900-02.highBoundary(8)",
      "input": [{}],
      "expected": ["@1900-02-28"]
    },
    {
      "name": "Year 2000 February (leap year)",
      "expression": "@2000-02.highBoundary(8)",
      "input": [{}],
      "expected": ["@2000-02-29"]
    },
    {
      "name": "Year 2004 February (leap year)",
      "expression": "@2004-02.highBoundary(8)",
      "input": [{}],
      "expected": ["@2004-02-29"]
    }
  ]
}