      "tags": ["filtering", "select", "union", "count"],
      "fromXML": "testSelect2"
    },
    {
      "name": "select() with contains expression",
      "expression": "name.select(use.contains('i')).count()",
      "expected": [3],
      "tags": ["filtering", "select", "contains", "count"],
      "fromXML": "testSelect3"
    }
  ]
