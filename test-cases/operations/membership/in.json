{
  "name": "In Operator Tests",
  "description": "Tests for the in (membership) operator",
  "tests": [
    {
      "name": "in - string in collection",
      "expression": "'active' in ('active' | 'inactive' | 'pending')",
      "input": [],
      "expected": [
        true
      ],
      "tags": [
        "operator",
        "membership",
        "in",
        "operator:in"
      ]
    },
    {
      "name": "in - number in collection",
      "expression": "1 in (1 | 2 | 3)",
      "input": [],
      "expected": [
        true
      ],
      "tags": [
        "operator",
        "membership",
        "in",
        "operator:in"
      ],
      "fromXML": "testIn1"
    },
    {
      "name": "in - single string not equal to another string",
      "expression": "'a' in 'abc'",
      "input": [],
      "expected": [
        false
      ],
      "tags": [
        "operator",
        "membership",
        "in",
        "string",
        "operator:in"
      ],
      "description": "'in' operator checks equality, not substring. 'a' != 'abc', so result is false"
    },
    {
      "name": "in - not found",
      "expression": "4 in (1 | 2 | 3)",
      "input": [],
      "expected": [
        false
      ],
      "tags": [
        "operator",
        "membership",
        "in",
        "operator:in"
      ]
    },
    {
      "name": "contains - collection contains item",
      "expression": "(1 | 2 | 3) contains 1",
      "input": [],
      "expected": [
        true
      ],
      "tags": [
        "operator",
        "membership",
        "contains",
        "operator:in"
      ]
    },
    {
      "name": "contains - string collection contains character",
      "expression": "('a' | 'b' | 'c') contains 'a'",
      "input": [],
      "expected": [
        true
      ],
      "tags": [
        "operator",
        "membership",
        "contains",
        "string",
        "operator:in"
      ]
    },
    {
      "name": "contains - not found",
      "expression": "(1 | 2 | 3) contains 4",
      "input": [],
      "expected": [
        false
      ],
      "tags": [
        "operator",
        "membership",
        "contains",
        "operator:in"
      ]
    },
    {
      "name": "in - empty left operand",
      "expression": "{} in (1 | 2 | 3)",
      "input": [],
      "expected": [],
      "tags": [
        "operator",
        "membership",
        "in",
        "empty",
        "operator:in"
      ],
      "description": "When left operand is empty, result is empty per spec",
      "fromXML": "testInEmptyValue"
    },
    {
      "name": "in - empty right operand",
      "expression": "1 in {}",
      "input": [],
      "expected": [
        false
      ],
      "fromXML": "testInEmptyCollection",
      "tags": [
        "operator",
        "membership",
        "in",
        "empty",
        "operator:in"
      ],
      "description": "When right operand is empty, result is false per spec"
    },
    {
      "name": "contains - single string is not a collection",
      "expression": "'abc' contains 'x'",
      "input": [],
      "expected": [
        false
      ],
      "tags": [
        "operator",
        "membership",
        "contains",
        "string",
        "operator:contains"
      ],
      "description": "'contains' operator checks if item is in collection. Single string 'abc' as collection has one item 'abc', which != 'x'"
    },
    {
      "name": "contains - empty left operand",
      "expression": "{} contains 1",
      "input": [],
      "expected": [
        false
      ],
      "tags": [
        "operator",
        "membership",
        "contains",
        "empty",
        "operator:contains"
      ],
      "description": "When left operand is empty, result is false per spec"
    },
    {
      "name": "contains - empty right operand",
      "expression": "(1 | 2 | 3) contains {}",
      "input": [],
      "expected": [],
      "tags": [
        "operator",
        "membership",
        "contains",
        "empty",
        "operator:contains"
      ],
      "description": "When right operand is empty, result is empty per spec"
    },
    {
      "name": "testIn2",
      "expression": "1 in (2 | 3)",
      "expected": [
        false
      ],
      "tags": [
        "in",
        "membership",
        "xml-ported"
      ],
      "fromXML": "testIn2",
      "inputFile": "../../patient-example.json"
    },
    {
      "name": "testIn3",
      "expression": "'a' in ('a' | 'c' | 'd')",
      "expected": [
        true
      ],
      "tags": [
        "in",
        "membership",
        "xml-ported"
      ],
      "fromXML": "testIn3",
      "inputFile": "../../patient-example.json"
    },
    {
      "name": "testIn4",
      "expression": "'b' in ('a' | 'c' | 'd')",
      "expected": [
        false
      ],
      "tags": [
        "in",
        "membership",
        "xml-ported"
      ],
      "fromXML": "testIn4",
      "inputFile": "../../patient-example.json"
    },
    {
      "name": "testIn5",
      "expression": "('a' | 'c' | 'd') in 'b'",
      "expected": [],
      "tags": [
        "in",
        "membership",
        "xml-ported"
      ],
      "fromXML": "testIn5",
      "inputFile": "../../patient-example.json",
      "note": "Multiple values on left side returns empty per spec"
    },
    {
      "name": "testInEmptyBoth",
      "expression": "{} in {}",
      "expected": [],
      "tags": [
        "in",
        "membership",
        "xml-ported"
      ],
      "fromXML": "testInEmptyBoth",
      "inputFile": "../../patient-example.json"
    }
  ]
}
