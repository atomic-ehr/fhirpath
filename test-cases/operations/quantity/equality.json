{
  "name": "Quantity Equality Tests",
  "description": "Equality tests for Quantity types. NOTE: Calendar durations (year, month, day, etc.) are treated as incomparable with different units or UCUM units, returning empty collection per FHIRPath spec for incomparable values. This avoids incorrect assumptions about calendar conversions (e.g., 1 month != always 30 days).",
  "tests": [
    {
      "name": "Different quantity units for year",
      "description": "Calendar 'year' vs UCUM 'a' are incomparable - returns empty",
      "expression": "1 year != 1 'a'",
      "input": [],
      "expected": [false],
      "tags": ["quantity", "equality", "calendar-duration", "ucum", "incomparable"]
    },
    {
      "name": "Calendar duration conversion - months to years",
      "description": "Different calendar units are incomparable - returns empty (no implicit conversion)",
      "expression": "12 months = 1 year",
      "input": [],
      "expected": [],
      "tags": ["quantity", "equality", "calendar-duration", "incomparable"]
    },
    {
      "name": "UCUM duration - months to years",
      "expression": "12 'mo' = 1 'a'",
      "input": [],
      "expected": [true],
      "tags": ["quantity", "equality", "ucum"]
    },
    {
      "name": "Same calendar duration",
      "expression": "1 year = 1 year",
      "input": [],
      "expected": [true],
      "tags": ["quantity", "equality", "calendar-duration"]
    },
    {
      "name": "Calendar month vs UCUM month",
      "description": "Calendar 'month' vs UCUM 'mo' are incomparable - returns empty",
      "expression": "1 month != 1 'mo'",
      "input": [],
      "expected": [false],
      "tags": ["quantity", "inequality", "calendar-duration", "ucum", "incomparable"]
    },
    {
      "name": "Calendar month vs UCUM days - incomparable",
      "expression": "1 month = 30 'd'",
      "input": [],
      "expected": [],
      "tags": ["quantity", "equality", "calendar-duration", "ucum", "incomparable"]
    },
    {
      "name": "Calendar month to days conversion",
      "description": "Different calendar units (month vs days) are incomparable - returns empty",
      "expression": "1 month = 30 days",
      "input": [],
      "expected": [],
      "tags": ["quantity", "equality", "calendar-duration", "incomparable"]
    },
    {
      "name": "Calendar week vs UCUM week - incomparable",
      "expression": "1 week = 1 'wk'",
      "input": [],
      "expected": [],
      "tags": ["quantity", "equality", "calendar-duration", "ucum", "incomparable"]
    },
    {
      "name": "Calendar week to days conversion",
