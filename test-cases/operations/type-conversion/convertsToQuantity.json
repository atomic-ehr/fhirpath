{
  "name": "convertsToQuantity() function tests",
  "tags": ["type-conversion", "convertsToQuantity"],
  "tests": [
    {
      "name": "convertsToQuantity - quantity literal with decimal",
      "expression": "10.1 'mg'.convertsToQuantity()",
      "expected": [true]
    },
    {
      "name": "convertsToQuantity - quantity literal with integer",
      "expression": "10 'mg'.convertsToQuantity()",
      "expected": [true]
    },
    {
      "name": "convertsToQuantity - quantity with calendar duration",
      "expression": "4 'days'.convertsToQuantity()",
      "expected": [true]
    },
    {
      "name": "convertsToQuantity - string with unit",
      "expression": "'10 mg'.convertsToQuantity()",
      "expected": [true]
    },
    {
      "name": "convertsToQuantity - string with decimal and unit",
      "expression": "'5.5 km'.convertsToQuantity()",
      "expected": [true]
    },
    {
      "name": "convertsToQuantity - string with calendar unit",
      "expression": "'2 weeks'.convertsToQuantity()",
      "expected": [true]
    },
    {
      "name": "convertsToQuantity - string with UCUM unit",
      "expression": "'100 mL'.convertsToQuantity()",
      "expected": [true]
    },
    {
      "name": "convertsToQuantity - number without unit",
      "expression": "10.convertsToQuantity()",
      "expected": [true],
      "tags": ["type-conversion", "convertsToQuantity", "integer"]
    },
    {
      "name": "convertsToQuantity - string number without unit",
      "expression": "'10'.convertsToQuantity()",
      "expected": [true],
      "tags": ["type-conversion", "convertsToQuantity", "string"]
    },
    {
      "name": "convertsToQuantity - invalid string",
      "expression": "'invalid'.convertsToQuantity()",
      "expected": [false]
    },
    {
      "name": "convertsToQuantity - boolean true",
      "expression": "true.convertsToQuantity()",
      "expected": [true],
      "tags": ["type-conversion", "convertsToQuantity", "boolean"],
      "fromXML": "testBooleanLiteralConvertsToQuantity"
    },
    {
      "name": "convertsToQuantity - boolean false",
      "expression": "false.convertsToQuantity()",
      "expected": [true],
      "tags": ["type-conversion", "convertsToQuantity", "boolean"]
    },
    {
      "name": "convertsToQuantity - empty input",
      "expression": "{}.convertsToQuantity()",
      "expected": []
    },
    {
      "name": "convertsToQuantity - error on multiple items",
      "expression": "(10 'mg' | 20 'mg').convertsToQuantity()",
      "error": true
    },
    {
      "name": "Decimal literal converts to Quantity",
      "expression": "1.0.convertsToQuantity()",
      "expected": [true],
      "tags": ["type-conversion", "convertsToQuantity", "decimal"],
      "fromXML": "testDecimalLiteralConvertsToQuantity"
    },
    {
      "name": "String '1' converts to Quantity",
      "expression": "'1'.convertsToQuantity()",
      "expected": [true],
      "tags": ["type-conversion", "convertsToQuantity", "string"],
      "fromXML": "testStringIntegerLiteralConvertsToQuantity"
    }
  ]
}