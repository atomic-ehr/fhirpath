      "expression": "'http://fhir.org/guides/cqf/common/Library/FHIR-ModelInfo|4.0.1'.matchesFull('library')",
      "expected": [
        false
      ],
      "tags": [
        "matches",
        "regex",
        "string",
        "xml-ported"
      ],
      "fromXML": "testMatchesFullWithinUrl1"
    },
    {
      "name": "testMatchesFullWithinUrl4",
      "expression": "'http://fhir.org/guides/cqf/common/Library/FHIR-ModelInfo|4.0.1'.matchesFull('^Library$')",
