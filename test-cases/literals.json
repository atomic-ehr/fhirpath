      "tags": ["literals", "boolean", "conversion"],
      "fromXML": "testLiteralBooleanTrue"
    },
    {
      "name": "boolean literal false converts to boolean",
      "expression": "false.convertsToBoolean()",
      "expected": [true],
      "tags": ["literals", "boolean", "conversion"],
      "fromXML": "testLiteralBooleanFalse"
    },
    {
